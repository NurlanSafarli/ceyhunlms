# Local settings. npm run setup:local copies this file without overwriting .env.
PORT=3001
DATABASE_PATH=.local/registrations.sqlite

# The first admin password is entered privately in the terminal during setup.
# No default password. Do not add VITE_ to secret variable names.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Later, for Docker Compose deployment: your real domain, without https:// or /.
# Point its DNS A record to your server and open ports 80 and 443.
DOMAIN=

# Advanced native deployments only. Docker Compose sets these automatically.
# HOST=127.0.0.1
# TRUST_PROXY_HOPS=0
# COOKIE_SECURE=true
